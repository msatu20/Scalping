# Copiar a .env (nunca commitear .env). Claves SIN permiso de retirada y con whitelist de IP.

# paper | testnet | live  (live requiere además LIVE_TRADING_CONFIRMED=true, ver ADR-0002)
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# Requeridas en testnet/live (BINANCE_SECRET también se acepta como alias)
BINANCE_API_KEY=
BINANCE_API_SECRET=

SYMBOLS=BTCUSDT,ETHUSDT

# Comisiones USDT-M VIP0 (fracción, no %): maker 0.02 %, taker 0.05 %
MAKER_FEE=0.0002
TAKER_FEE=0.0005

# Apalancamiento máximo (tope absoluto en código: 10)
MAX_LEVERAGE=3
